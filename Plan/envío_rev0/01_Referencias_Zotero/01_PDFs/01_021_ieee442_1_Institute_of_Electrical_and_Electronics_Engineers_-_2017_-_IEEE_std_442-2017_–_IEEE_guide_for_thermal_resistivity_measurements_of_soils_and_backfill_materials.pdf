          <rdf:li xml:lang="x-default">IEEE Std 442â„¢-2017 (Revision of IEEE Std 442-1981) IEEE Guide for Thermal Resistivity Measurements of Soils and Backfill Materials</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Insulated Conductors Committee of the IEEE Power and Energy Society</rdf:li>
        </rdf:Seq>
      </dc:creator>
