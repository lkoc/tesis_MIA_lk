{
  "type": "dc_linear_temperature",
  "reference_temperature_C": 20.0,
  "temperature_tolerance_K": 0.00001,
  "temperature_limit_C": 90.0,
  "max_iterations": 500,
  "law": "P_j = I_j^2 * R20_j * (1 + alpha_j * (T_conductor_j - 20))",
  "coupling": "individual conductor temperature; same law in PINN and FEniCSx",
  "excluded_losses": ["dielectric", "screen", "sheath", "skin_effect", "proximity_effect"]
}
